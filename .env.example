# ==============================================================================
# sHub Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to C:\dev\.env (outside repository version control) and fill in
# your local paths and credentials. NEVER commit real secrets or tokens.

# Git / GitHub Repository Configuration
GITHUB_USER="your-github-username"
GITHUB_TOKEN="ghp_replace_with_your_personal_access_token"
GITHUB_REPO_SHUB="https://github.com/your-username/sHub.git"

# Android SDK & Java Toolchain
ANDROID_SDK_ROOT="C:/Users/your-user/AppData/Local/Android/Sdk"
JAVA_HOME="C:/Program Files/Android/Android Studio/jbr"

# Engineering & Reference Libraries
ENGINEERING_LIBRARY_PATH="C:/dev/engineering-library"
SER_TOOLS_PATH="C:/dev/s_SER_Tools"

# GIS Offline Tile Acquisition (Authorized Commercial / Open Providers Only)
GIS_TILE_PROVIDER_NAME="Esri_World_Imagery_Licensed"
GIS_TILE_PROVIDER_URL_TEMPLATE="https://example-licensed-provider.com/tiles/{z}/{y}/{x}"
GIS_TILE_PROVIDER_API_KEY="replace_with_authorized_tile_provider_key"
GIS_DEFAULT_UTM_ZONES="31980,31981"

